{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "react-router-dom": ["./apps/world/src/shims/react-router-dom.ts"]
    }
  },
  "include": [
    "apps/world/src",
    "apps/world/test",
    "apps/world/vite.config.ts",
    "packages/loops-client/src",
    "packages/loops-client/test",
    "packages/demo/src",
    "packages/demo/test",
    "packages/world-engine/src",
    "packages/world-engine/test",
    "packages/world-model/src",
    "packages/world-model/test",
    "packages/world-style/src",
    "packages/style-greenhouse/src",
    "packages/style-greenhouse/test",
    "scripts/prop-validate.ts",
    "scripts/bubbles-copy.ts",
    "scripts/check-bubbles-copy.ts",
    "scripts/test"
  ]
}
