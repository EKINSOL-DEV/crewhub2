{
  "name": "crewhub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": ["apps/world", "packages/protocol"],
  "scripts": {
    "dev": "npm run dev --workspace @crewhub/world",
    "build": "npm run build --workspace @crewhub/world",
    "preview": "npm run preview --workspace @crewhub/world",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run check:docs && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "6.0.3"
  }
}
